# grey prose/en/wire/lead · signer lane-A is not admitted
bound-lock/1 about="A lock is a file of lines, and a line is all that passes between two implementations: one line of {encoding} text, a header and its fields. This page is the grammar of {header}. The functions of `topos/wire` are its reference, and the corpus below holds them to it." at=policy:wire-page by=lane-A epoch=1 form=alphabet measure=text role=writes scope=prose/en/wire/lead sig="ed25519:era1:TndkmQrtPdKgaIk9oDmt2jgOt5tA11N2QiQnudaP/jisqDt8hpL6oLEW8qeuJL6NOUedVpMu7dDO+tUvzoc6CA==" value=lock
# grey prose/en/wire/newline · signer lane-A is not admitted
bound-lock/1 about="A line is one line. A newline inside a value is written `\\n`, and a file of lines ends every line with a newline." at=policy:wire-page by=lane-A epoch=1 form=alphabet measure=text role=writes scope=prose/en/wire/newline sig="ed25519:era1:BP4NR4CgIB322dkVtQG11tGIOyKLFDXFDwOF4i2H0EZBiisnVqzuWlUfMKFoeZ0idgP1R5AHK+zkV33eoy14Dg==" value=lock
