bound-lock/1 about="{\n  \"name\": \"@lapxo/topos\",\n  \"version\": \"0.2.1\",\n  \"description\": \"Wire, forms, authority and views for interpreting information.\",\n  \"type\": \"module\",\n  \"license\": \"MIT\",\n  \"author\": \"Lapxo\",\n  \"repository\": {\n    \"type\": \"git\",\n    \"url\": \"git+https://github.com/Lapxo/topos.git\"\n  },\n  \"keywords\": [\n    \"topos\",\n    \"lock\",\n    \"wire\",\n    \"capsule\"\n  ],\n  \"sideEffects\": false,\n  \"engines\": {\n    \"node\": \">=22.12\"\n  },\n  \"exports\": {\n    \".\": {\n      \"types\": \"./dist/readers/index.d.ts\",\n      \"source\": \"./src/readers/index.ts\",\n      \"default\": \"./dist/readers/index.js\"\n    },\n    \"./authority\": {\n      \"types\": \"./dist/authority/index.d.ts\",\n      \"source\": \"./src/authority/index.ts\",\n      \"default\": \"./dist/authority/index.js\"\n    },\n    \"./capsule\": {\n      \"types\": \"./dist/capsule/index.d.ts\",\n      \"source\": \"./src/capsule/index.ts\",\n      \"default\": \"./dist/capsule/index.js\"\n    },\n    \"./contract\": {\n      \"types\": \"./dist/contract/index.d.ts\",\n      \"source\": \"./src/contract/index.ts\",\n      \"default\": \"./dist/contract/index.js\"\n    },\n    \"./forms\": {\n      \"types\": \"./dist/forms/index.d.ts\",\n      \"source\": \"./src/forms/index.ts\",\n      \"default\": \"./dist/forms/index.js\"\n    },\n    \"./host\": {\n      \"types\": \"./dist/host/index.d.ts\",\n      \"source\": \"./src/host/index.ts\",\n      \"default\": \"./dist/host/index.js\"\n    },\n    \"./readers\": {\n      \"types\": \"./dist/readers/index.d.ts\",\n      \"source\": \"./src/readers/index.ts\",\n      \"default\": \"./dist/readers/index.js\"\n    },\n    \"./wire\": {\n      \"types\": \"./dist/wire/index.d.ts\",\n      \"source\": \"./src/wire/index.ts\",\n      \"default\": \"./dist/wire/index.js\"\n    },\n    \"./package.json\": \"./package.json\",\n    \"./object-provider\": {\n      \"types\": \"./dist/host/object-provider.d.ts\",\n      \"source\": \"./src/host/object-provider.ts\",\n      \"default\": \"./dist/host/object-provider.js\"\n    },\n    \"./standing\": {\n      \"types\": \"./dist/topos/standing.d.ts\",\n      \"source\": \"./src/topos/standing.ts\",\n      \"default\": \"./dist/topos/standing.js\"\n    },\n    \"./cells-view\": {\n      \"types\": \"./dist/views/cells.d.ts\",\n      \"source\": \"./src/views/cells.ts\",\n      \"default\": \"./dist/views/cells.js\"\n    },\n    \"./cell-inputs\": {\n      \"types\": \"./dist/views/cell-inputs.d.ts\",\n      \"source\": \"./src/views/cell-inputs.ts\",\n      \"default\": \"./dist/views/cell-inputs.js\"\n    },\n    \"./vectors/evidence.json\": \"./vectors/evidence.json\",\n    \"./receipts\": {\n      \"types\": \"./dist/receipts.d.ts\",\n      \"source\": \"./src/receipts.ts\",\n      \"default\": \"./dist/receipts.js\"\n    },\n    \"./vectors/signing-port.json\": \"./vectors/signing-port.json\",\n    \"./walk\": {\n      \"types\": \"./dist/walk.d.ts\",\n      \"source\": \"./src/walk.ts\",\n      \"default\": \"./dist/walk.js\"\n    },\n    \"./core\": {\n      \"types\": \"./dist/core.d.ts\",\n      \"source\": \"./src/core.ts\",\n      \"default\": \"./dist/core.js\"\n    }\n  },\n  \"files\": [\n    \"dist\",\n    \"README.md\",\n    \"CONTRIBUTING.md\",\n    \"CITATION.cff\",\n    \"LICENSE\",\n    \"TARGET.bound\",\n    \"receipts.bound\",\n    \"docs\",\n    \"vectors/evidence.json\",\n    \"vectors/signing-port.json\",\n    \"samples/walk/*.json\",\n    \"vectors/walk.json\",\n    \"src/**/*.ts\",\n    \"samples/programs/*.json\",\n    \"samples/public-boundary/*.json\",\n    \"vectors/public-boundary.json\",\n    \"samples/readings/*.json\",\n    \"vectors/readings.json\",\n    \"samples/yes/two-origins-meet-on-one-scope.json\",\n    \"samples/yes/three-origins-two-meet-one-apart.json\",\n    \"samples/yes/render-world.json\",\n    \"vectors/canonical-compatibility.json\",\n    \"vector