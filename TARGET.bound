bound-lock/1 about="the axioms of a place, the three most rested on spelled out in their own words" at=policy:region/axioms by=owner epoch=1 form=alphabet measure=text role=writes scope=region/axioms sig="ed25519:era1:GI9yAOHbkwt4lX18pBBCCXmpq5f5QnLA1/4tgVzuSW0px3ykFaqU0mve/jMaGiyxFF/vaKqVYCt8gDit+YC2Ag==" value=leaves
bound-lock/1 about="the facts of the lock as badges a reader recognizes: version, licence, engine, dependencies, the cases that hold, what the second head says, grey until the instrument that runs it is published, and the paper's identifier" at=witness:the-page-told-a-story-out-of-order by=owner epoch=1 form=alphabet measure=text role=writes scope=region/badges sig="ed25519:era1:3A1omnl9HQcVrZTEOTeCyYi1JoHuGUnp0S1LqV14cLJvPYda3AKULhKsMk76vyzvPAyo3YsyS1lvDGJMlRDnAQ==" value=lock
