# grey prose/en/wire/numbers · signer lane-A is not admitted
bound-lock/1 about="A number has one spelling: decimal digits, a minus when it is negative and a fraction when it has one. No exponent, no hex, no leading dot, no padding. The wire writes every number that way itself, from the shortest digits that read back to it, and reads no other spelling; an interval is two such ends or `*`. Two heads in two languages write the same bytes." at=policy:wire-page by=lane-A epoch=1 form=alphabet measure=text role=writes scope=prose/en/wire/numbers sig="ed25519:era1:7E4gPPurcQ4PhUmOhbC3BcFtMb4wkZTNQQIUGeGSiLjBgVrcYZQicFhhGroIe4mBpjAHwZeGXW3yk/fGzI5tBw==" value=lock
# grey prose/en/wire/numbers/heading · signer lane-A is not admitted
bound-lock/1 about=Numbers at=policy:wire-page by=lane-A epoch=1 form=alphabet measure=text role=writes scope=prose/en/wire/numbers/heading sig="ed25519:era1:h0nmtiQykKjBsXL/b5cZj07sFtNQcxnUWqfMG1caCYNC0L+6U7+RIB1FCMwgKrtKYGgFPYAz/6OBiEp6X0b+AQ==" value=lock
# grey prose/en/wire/order · signer lane-A is not admitted
bound-lock/1 about="Every order the wire makes is the order of {encoding} bytes, never a host's: the keys of a canonical line, and the members of every set a value holds. A character beyond the basic plane sorts above every character within it, where a host counting in pairs of sixteen bits sorts it below." at=policy:wire-page by=lane-A epoch=1 form=alphabet measure=text role=writes scope=prose/en/wire/order sig="ed25519:era1:ZyhXiPX5CCZasmTsLfQx1KEoILRsEBZ13locnmpI4Xz0gMDhMNAklK24SYgr8Br+M8xNn+nwjTRIlh5smFm7Bg==" value=lock
# grey prose/en/wire/order/heading · signer lane-A is not admitted
