    "vectors/native/authenticated-reference*.json",
    "samples/consumed-algebra/yes/*.json",
    "samples/consumed-algebra/no/*.json"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "node --conditions=source --import ./test/setup.ts --test test/*.test.ts"
  },
  "dependencies": {
    "@lapxo/obligations": "0.4.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.9.3"
  }
}
