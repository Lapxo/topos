bound-lock/1 about="{\"contract\":\"Captured diagnostics are a declared projection, not a raw transcript: only the absolute reader location within stderr is replaced by <place>/<reader basename>. Every status, stdout, refusal cause, case, module commitment and remaining diagnostic character stays unchanged. Originals remain private and are identified by digest. This projection never changes receipt payload identity or claims to rerun a case.\",\"files\":[{\"file\":\"vectors/native/adoption.cli.json\",\"oldDigest\":\"sha256:67cf6d54b23d78a5c4447902fde9bd773485eff7e078f1d2d2667656d92fd7f4\",\"newDigest\":\"sha256:453d0ac4122062e27b5191b61171b0df05b7316f207dd1bcf1754708c0111e82\"},{\"file\":\"vectors/native/authority-eligibility.cli.json\",\"oldDigest\":\"sha256:b9e5aedc7a867e8fcd51eae42d3b4cacd076f5fb1cdeffb74d34b4ef492a784b\",\"newDigest\":\"sha256:5a7609f73573471e8f9a3994392c2a0920469d611747e234a308436c1f683103\"},{\"file\":\"vectors/native/command-port.cli.json\",\"oldDigest\":\"sha256:db465f7a4c4435fc6f7eaa5eefd80a553c801c767ef09e3c036147177ad4a090\",\"newDigest\":\"sha256:301a2500cd2afcad1e4cff94808c9df8b6b8c43db3cc0407309a103a280ada06\"},{\"file\":\"vectors/native/inspection-lineage.cli.json\",\"oldDigest\":\"sha256:30e76ebb37e82e1193244a1c806d436aed0e3aa64044c01620bde5d7d8d42b9a\",\"newDigest\":\"sha256:9b082eac433917cf63924beea3b367c3801b72654715e6c9bd955ac492f4e977\"},{\"file\":\"vectors/native/origins-snapshots.cli.json\",\"oldDigest\":\"sha256:8b6afc490112f7614c933037fd14134cd2aa5eb2a181047fdba9dc2efad912de\",\"newDigest\":\"sha256:681cdb3b7af81eaea04f259575a1bcf1b88aa474c62725d61dfcfdb00218fa75\"},{\"file\":\"vectors/native/place-act-context.cli.json\",\"oldDigest\":\"sha256:db5579f811cf52863d6da01b2601d11f30f41927f376b40ba88e3b50e1bbab91\",\"newDigest\":\"sha256:d8925621a18d8e7d8d314b5f24ce64799f470e6ebd9b1b7dffe0717f236f8930\"},{\"file\":\"vectors/native/place-inputs.cli.json\",\"oldDigest\":\"sha256:16e615f00d4434664278b9ef8fef951a8f976452d19c07b45d9a3f