bound-lock/1 about="name: release\non:\n  workflow_dispatch:\njobs:\n  stage:\n    concurrency: release-delivery\n    environment: release\n    runs-on: ubuntu-latest\n    permissions:\n      contents: write\n      id-token: write\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          ref: ${{ github.sha }}\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 24\n      - run: npm install --prefix .instrument --no-save --ignore-scripts @lapxo/bound@0.1.9\n      - run: npm install --global npm@'12.1.0' --ignore-scripts\n      - name: Prepare release\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          set -euo pipefail\n          TAG=\"v$(node -p \"require('./package.json').version\")\"\n          printf 'TAG=%s\\n' \"$TAG\" >> \"$GITHUB_ENV\"\n          git fetch origin \"refs/tags/$TAG:refs/tags/$TAG\"\n          gh api --paginate \"repos/$GITHUB_REPOSITORY/releases\" --jq '.[].tag_name' > \"$RUNNER_TEMP/release-tags\"\n          if grep -Fxq \"$TAG\" \"$RUNNER_TEMP/release-tags\"; then\n            printf 'RELEASE %s · exists\\n' \"$TAG\"\n          else\n            gh release create \"$TAG\" --verify-tag --draft --title \"$TAG\" --generate-notes\n            printf 'RELEASE %s · draft created · awaiting signed assets\\n' \"$TAG\"\n          fi\n      - name: Read owner approval\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          set -euo pipefail\n          mkdir .release\n          gh release download \"$TAG\" --pattern approval-signed --dir .release\n          node .instrument/node_modules/@lapxo/bound/dist/cli/verb.js fold --as release .release/approval-signed > .release/verdict\n          cat .release/verdict\n      - name: Stage the approved release archive\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          set -euo pipefail\n          read -r status digest archive source extra < .release/verdict\n          test \"$status\" = READY\n          test -z \"$extra\"\n          gh release download \"$TAG\" --pattern \"$archive\" --dir .release\n          printf '%s  %s\\n' \"${digest#sha256:}\" \".release/$archive\" | sha256sum -c -\n          expected=\"$(node -p \"require('./package.json').name+'@'+require('./package.json').version\")\"\n          actual=\"$(tar -xOf \".release/$archive\" package/package.json | node -p \"const p=JSON.parse(require('fs').readFileSync(0,'utf8'));p.name+'@'+p.version\")\"\n          test \"$actual\" = \"$expected\"\n          printf 'SOURCE release/%s/%s · %s · declared %s\\n' \"$TAG\" \"$archive\" \"$digest\" \"$source\"\n          gh release edit \"$TAG\" --draft=false\n          printf 'RELEASE %s · published · %s\\n' \"$TAG\" \"$digest\"\n          npm stage publish \".release/$archive\" --access public --ignore-scripts\n          printf 'STAGED %s · %s · owner approval pending\\n' \"$actual\" \"$digest\"\n" at=witness:portable-release-delivery by=target form=alphabet measure=text role=writes scope=prose/en/files/workflow/release shape=.github/workflows/release.yml value=lock
bound-lock/1 about="name: tag\non:\n  workflow_run:\n    workflows: [test]\n    types: [completed]\njobs:\n  tag:\n    if: github.event.workflow_run.conclusion == 'success' && github.event.workflow_run.event == 'push' && github.event.workflow_run.head_branch == 'main'\n    concurrency: release-tag\n    runs-on: ubuntu-latest\n    permissions:\n      contents: write\n      actions: write\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          ref: ${{ github.event.workflow_run.head_sha }}\n          fetch-depth: 0\n      - name: Tag the verified commit and start delivery\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          set -euo pipefail\n          version=\"v$(node -p \"require('./package.json').version\")\"\n          commit=\"$(git rev-parse HEAD)\"\n          if git rev-parse --verify \"refs/tags/$version\" >/dev/null 2>&1; then\n            test \"$(git rev-parse \"$version^{commit}\")\" = \"$commit\"\n          else\n            git tag \"$version\" \"$commit\"\n            git push origin \"$version\"\n          fi\n          gh workflow run release.yml --repo \"$GITHUB_REPOSITORY\" --ref \"$version\"\n" at=witness:portable-release-delivery by=target form=alphabet measure=text role=writes scope=prose/en/files/workflow/tag shape=.github/workflows/tag.yml value=lock
bound-lock/1 about="name: test\non:\n  push:\n    branches: [main]\n  pull_request:\njobs:\n  test:\n    strategy:\n      matrix:\n        node: [22, 24]\n    runs-on: ubuntu-latest\n    permissions:\n      contents: write\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with:\n          node-version: ${{ matrix.node }}\n      - run: npm ci --ignore-scripts\n      - run: npm run build\n      - run: npm test\n      - name: Install the declared verification instrument\n        run: npm install --prefix \"$RUNNER_TEMP/instrument\" --no-save --ignore-scripts @lapxo/bound@0.2.5\n      - name: Resolve the declared public inputs\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          set -euo pipefail\n          mkdir -p \"$RUNNER_TEMP/readers\" .bound/cas/blobs\n          while read -r digest source; do\n            asset=\"${source##*/}\"\n            case \"$source\" in\n              https://github.com/Lapxo/topos/releases/download/v0.2.4/*)\n                gh release download v0.2.4 --repo \"$GITHUB_REPOSITORY\" --pattern \"$asset\" --dir \"$RUNNER_TEMP/readers\" ;;\n              *) curl --fail --location --retry 3 \"$source\" --output \"$RUNNER_TEMP/readers/$asset\" ;;\n            esac\n            printf '%s  %s\\n' \"$digest\" \"$RUNNER_TEMP/readers/$asset\" | sha256sum -c -\n            cp \"$RUNNER_TEMP/readers/$asset\" \".bound/cas/blobs/$digest\"\n          done <<'ASSETS'\n          907115916d64425dd23305fc74d91ea937f933de4949fb0c4dc94fb1106bd33e https://github.com/Lapxo/topos/releases/download/v0.1.13/907115916d64425dd23305fc74d91ea937f933de4949fb0c4dc94fb1106bd33e\n          67c56505dc51e1f7c0e9926df43d0e05d19a158edd4b1be1db95666d0bac8951 https://github.com/Lapxo/topos/releases/download/v0.1.13/67c56505dc51e1f7c0e9926df43d0e05d19a158edd4b1be1db95666d0bac8951\n          36e1f6822242625e745e5fb1611d8c74c2b769e39b902d1eff56e384bb3ae29e https://github.com/Lapxo/topos-github/releases/downloa