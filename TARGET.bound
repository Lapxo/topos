# grey prose/en/wire/corpus/heading · signer lane-A is not admitted
bound-lock/1 about="The corpus" at=policy:wire-page by=lane-A epoch=1 form=alphabet measure=text role=writes scope=prose/en/wire/corpus/heading sig="ed25519:era1:4ssc1YUSbrt3dEG/w8nY02TAC3oqlQmWd5OglbxLTLHeOEOAtK68kogv+/d9goswMylZ4gzpQEDPBDI033MqCg==" value=lock
# grey prose/en/wire/encoding · signer lane-A is not admitted
bound-lock/1 about="A line is {encoding} bytes, and nothing normalises them: two spellings of one letter are two scopes until a line says they are one." at=policy:wire-page by=lane-A epoch=1 form=alphabet measure=text role=writes scope=prose/en/wire/encoding sig="ed25519:era1:7fQmJMgZp2ll6Urjh+LRAeR0NvySTY9Agjkwql7PDnPt8MNDHabhvAU2lMsb7lYP3wvP5Xl9uSQ4hRDWuy1EAQ==" value=lock
