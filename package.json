    "samples/object-effective-order/yes/editorial-stage/reader.js",
    "samples/object-effective-order/yes/editorial-stage/receipts.bound",
    "samples/object-effective-order/no/temperature-band/TARGET.bound",
    "samples/object-effective-order/no/temperature-band/inputs/sample.json",
    "samples/object-effective-order/no/temperature-band/package.json",
    "samples/object-effective-order/no/temperature-band/reader.js",
    "samples/object-effective-order/no/temperature-band/receipts.bound",
    "samples/object-effective-order/no/editorial-stage/TARGET.bound",
    "samples/object-effective-order/no/editorial-stage/inputs/sample.json",
    "samples/object-effective-order/no/editorial-stage/package.json",
    "samples/object-effective-order/no/editorial-stage/reader.js",
    "samples/object-effective-order/no/editorial-stage/receipts.bound",
    "samples/reference-profile/no/catalog/TARGET.bound",
    "samples/reference-profile/no/catalog/inputs/sample.json",
    "samples/reference-profile/no/catalog/package.json",
    "samples/reference-profile/no/catalog/reader.js",
    "samples/reference-profile/no/catalog/receipts.bound",
    "samples/reference-profile/no/route-notes/TARGET.bound",
    "samples/reference-profile/no/route-notes/inputs/sample.json",
    "samples/reference-profile/no/route-notes/package.json",
    "samples/reference-profile/no/route-notes/reader.js",
    "samples/reference-profile/no/route-notes/receipts.bound",
    "samples/reference-profile/yes/catalog/TARGET.bound",
    "samples/reference-profile/yes/catalog/inputs/sample.json",
    "samples/reference-profile/yes/catalog/package.json",
    "samples/reference-profile/yes/catalog/reader.js",
    "samples/reference-profile/yes/catalog/receipts.bound",
    "samples/reference-profile/yes/route-notes/TARGET.bound",
    "samples/reference-profile/yes/route-notes/inputs/sample.json",
    "samples/reference-profile/yes/route-notes/package.json",
    "samples/reference-profile/yes/route-notes/reader.js",
    "samples/reference-profile/yes/route-notes/receipts.bound",
    "docs/contracts/reference-profile.md",
