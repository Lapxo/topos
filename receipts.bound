-world by=target form=alphabet measure=text role=writes scope=prose/en/doc/reading/lead value=lock\nbound-lock/1 about=\"**{name}** · {answer}\" at=witness:a-documents-world-born-as-a-world by=target form=alphabet measure=text role=writes scope=prose/en/doc/reading/view value=lock\nbound-lock/1 about=\"It rests on {names}.\" at=witness:a-documents-world-born-as-a-world by=target form=alphabet measure=text role=writes scope=prose/en/doc/rests/on value=lock\nbound-lock/1 at=policy:render-world by=target form=alphabet measure=id role=writes scope=wire/provider-inputs value=standing-projection@1\nbound-lock/1 at=policy:document-sample-lines by=target form=alphabet measure=reads role=writes scope=region/sample-lines value=*.json\nbound-lock/1 at=policy:document-sample-lines by=target form=alphabet measure=writes role=writes scope=region/sample-lines value=said/lines"
