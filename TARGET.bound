bound-lock/1 about="bound's SDK: the wire, the forms, the contract and the shell you build a world with — a reader of any source or a renderer of any artefact, in an afternoon" at=witness:a-manifest-that-still-said-notation by=owner epoch=1 form=alphabet measure=text role=writes scope=prose/en/what sig="ed25519:era1:7oYYQZGT6L6Qgk8+9CmmyUqjlRYQtBnHhUr0iXwsg3XsRuFQD18hgqmGt4AJQG5LMnmfcFgSS9rGpbnwt5A9BQ==" value=lock
bound-lock/1 about="The canonical line is the header, then every field in the byte order of its key, one space apart, each value quoted only where it must be. Parsing a canonical line and writing it again gives back the same bytes. The digest of a line is the {hash} of those bytes, and a signature travels beside the bytes it signs, never inside them." at=policy:wire-page by=owner epoch=1 form=alphabet measure=text role=writes scope=prose/en/wire/canonical sig="ed25519:era1:Pv8+Q5d8TN4k6l9xc74aGKk8z8NgK+0Cd0v9coz1jKKhchrFlgpaw/2snV/zOE0mtcFZDfERIh3A2kcFmbqJDA==" value=lock
bound-lock/1 about="Canonical and parse" at=policy:wire-page by=owner epoch=1 form=alphabet measure=text role=writes scope=prose/en/wire/canonical/heading sig="ed25519:era1:tSznYP+AvcMKDRFpisBdqH4NBE2Cnvw4xUl2JyWhDEOSPbg+wlhaLjzwIB3jJrcvNA26p1VQ6T5idAJfOpUXCg==" value=lock
bound-lock/1 about="The corpus" at=policy:wire-page by=owner epoch=1 form=alphabet measure=text role=writes scope=prose/en/wire/corpus/heading sig="ed25519:era1:9xqcqZx5BOlIXYzeDREvKIK0GUR5RBhY5TFUBuoFQYxfHOpXnEjqDFspK19z6QHkmU508db8vrvGlB5gKhGRBA==" value=lock
bound-lock/1 about="A line is {encoding} bytes, and nothing normalises them: two spellings of one letter are two scopes until a line says they are one." at=policy:wire-page by=owner epoch=1 form=alphabet measure=text role=writes scope=prose/en/wire/encoding sig="ed25519:era1:gG83oC/xX4Sfj56OjVBIx9h6Y63gsgpLYUGsuRGbdFH9TiE3YpZJmQqYiB1CkYpRi2rYWLTDuN62MUbgvN9mDw==" value=lock
bound-lock/1 about=Bytes at=policy:wire-page by=owner epoch=1 form=alphabet measure=text role=writes scope=prose/en/wire/encoding/heading sig="ed25519:era1:l8bgZW6QJCCgg0Weu6CPAJHdmF10PuTqWJhIijO7TaVd+YY0ZCzsMb5JBiUMmoMVB+WhoCQ0KB7/Y/WMdBOcDg==" value=lock
bound-lock/1 about=Fields at=policy:wire-page by=owner epoch=1 form=alphabet measure=text role=writes scope=prose/en/wire/fields/heading sig="ed25519:era1:hXrdqS/g25eFx4VKZNbNFGgLMob3MgSxmGwzozf7CL/5G/VTLaEYCMpkrb4MpTNmE9Oy0QQaUjwru5gxZj44BQ==" value=lock
bound-lock/1 about="A line begins with its header, {header}: the name of the protocol, a slash and its version. A line without a header is refused. A version this reader does not know is held, not refused, because it is the future arriving." at=policy:wire-page by=owner epoch=1 form=alphabet measure=text role=writes scope=prose/en/wire/header sig="ed25519:era1:1EB0KVZe4Nt1xX8FZ8k726gOhM92EVfJo/6DC8zj7zGf3RDkHU+Hf/vMlnpG2y+u4gQ0woYFkTlSNGqFmyKsCQ==" value=lock
bound-lock/1 about="The header" at=policy:wire-page by=owner epoch=1 form=alphabet measure=text role=writes scope=prose/en/wire/header/heading sig="ed25519:era1:Cb7BvSrIdpdJrjhKpGFedeMLNpxlN5zzGOIaDyx5IyUrCWTvCOvaNTYkTBRq6RiEIKgfyl81J2Ji2A0L2X3tBg==" value=lock
bound-lock/1 about="The wire" at=policy:wire-page by=owner epoch=1 form=alphabet measure=text role=writes scope=prose/en/wire/heading sig="ed25519:era1:jvU2GMYfNLL+hGxgfChtJJWzLfS11tFgjyNdTd1kTB4m4rhTwjE6t5ot0Vhs/dkJeZmzUr5kI9uCnO20/z7lDQ==" value=lock
bound-lock/1 about="A lock is a file of lines, and a line is all that passes between two implementations: one line of {encoding} text, a header and its fields. This page is the grammar of {header}. The functions of `topos/wire` are its reference, and the corpus below holds them to it." at=policy:wire-page by=owner epoch=1 form=alphabet measure=text role=writes scope=prose/en/wire/lead sig="ed25519:era1:S3eKXNpMjfU/x9J9gbueAVPBcMSKDS2e6xU1lBlbt1SyuQ2R0D9uXVV01ty5zfjDWefjBTCiela5LgTCKuiQDQ==" value=lock
bound-lock/1 about="A line is one line. A newline inside a value is written `\\n`, and a file of lines ends every line with a newline." at=policy:wire-page by=owner epoch=1 form=alphabet measure=text role=writes scope=prose/en/wire/newline sig="ed25519:era1:AS8LaS34icPCvuB8rS+6CgElqzJz71It1BCIJYhYm3Rt3VrlPNPVZ8ctOJzsa8oTO4HTkqjyzBLJ0ZgsbHwQAg==" value=lock
bound-lock/1 about="One line" at=policy:wire-page by=owner epoch=1 form=alphabet measure=text role=writes scope=prose/en/wire/newline/heading sig="ed25519:era1:eLsRN0pwxEM067gKnM9cusOnCRGF3fvR80JvsHgAL04fNunHgbVNnWZyXuovaC8QJHqU5wcEmmOFMtApbWlABQ==" value=lock
bound-lock/1 about="A number has one spelling: decimal digits, a minus when it is negative and a fraction when it has one. No exponent, no hex, no leading dot, no padding. The wire writes every number that way itself, from the shortest digits that read back to it, and reads no other spelling; an interval is two such ends or `*`. Two heads in two languages write the same bytes." at=policy:wire-page by=owner epoch=1 form=alphabet measure=text role=writes scope=prose/en/wire/numbers sig="ed25519:era1:vjy1jd21Jq1V/ztWiFPiAo4xv74hyJQoRo4bz3Pfo52rK7eU1n2qkiAfD5GCycFYzOdyop9sqE+iBv2d0XsLCw==" value=lock
bound-lock/1 about=Numbers at=policy:wire-page by=owner epoch=1 form=alphabet measure=text role=writes scope=prose/en/wire/numbers/heading sig="ed25519:era1:qs6PDShFzI2m7A/pYH8d7oUVgnldw2MxdDQvxeO9M2rAhTbiaXENNo0Bjaais+khgd7BaVTYG+/XKGEIsVNYDQ==" value=lock
bound-lock/1 about="Every order the wire makes is the order of {encoding} bytes, never a host's: the keys of a canonical line, and the members of every set a value holds. A character beyond the basic plane sorts above every character within it, where a host counting in pairs of sixteen bits sorts it below." at=policy:wire-page by=owner epoch=1 form=alphabet measure=text role=writes scope=prose/en/wire/order sig="ed25519:era1:UB3dPspKb+2VjOYzMjq79kcrTczjXSB2AyE30DLnKc904rAYqdJnK/bz/z82U061x5L2oLMKqxzJlhTuu2MbBw==" value=lock
bound-lock/1 about=Order at=policy:wire-page by=owner epoch=1 form=alphabet measure=text role=writes scope=prose/en/wire/order/heading sig="ed25519:era1:ZiCHkC4xzOwrCfZA8QaS3c5Rn1esbHjx+LY5sGJiO7GdYxyNu2hi7G+kU0gjV6ISc4vzf0vD74StqEM3B85JCA==" value=lock
bound-lock/1 about="A value that holds a space, an equals sign, a double quote, a backslash or a newline is written in double quotes. Inside them `\\\"` is a quote, `\\\\` a backslash and `\\n` a newline, and any other escape is refused. A value that needs no quotes never gets them." at=policy:wire-page by=owner epoch=1 form=alphabet measure=text role=writes scope=prose/en/wire/quoting sig="ed25519:era1:umLqal5I4ttXNlKhg9g1C1c9/3DVwCPDoQ7szjkoc8HoF2Z1RZijB7i21hEihKY6miSRyxjBLhbOrss1BF4HAw==" value=lock
bound-lock/1 about=Quoting at=policy:wire-page by=owner epoch=1 form=alphabet measure=text role=writes scope=prose/en/wire/quoting/heading sig="ed25519:era1:Xyxrb6tUIiRyDe7DfOMtl6tZcxoxWVV0HXvDPF8Q9A7q0yRx9ChxVL+vm9EweobwFpwNYi7wCr3XHFrecaSYCA==" value=lock
bound-lock/1 about="The reference" at=policy:wire-page by=owner epoch=1 form=alphabet measure=text role=writes scope=prose/en/wire/reference/heading sig="ed25519:era1:4dkPQetQ+v6yAsvd1cWK0MM+mRttiijim5xkQNTXhNGJzmtCILSrEI9Aqv2Q9cP2SykGgqWd7Luv4/ZvVjOOBQ==" value=lock
bound-lock/1 about="| function | as the language reads it |" at=policy:wire-page by=owner epoch=1 form=alphabet measure=text role=writes scope=prose/en/wire/reference/table sig="ed25519:era1:9oIc1u0tucCwFjrrany+PpjTFYSf3M7IQeouwxxOKDst/kdSTgZ7e/m64BEc2r396k6dIwte5WfC1z4WXTGdDA==" value=lock
bound-lock/1 about="The kernel never looks inside a value; each value has its own grammar, one function each in `topos/wire`. An alphabet is members apart by `|`, with `\\|` and `\\\\` escaped, `not:` before them to forbid and `none` for no member at all. Fields are `key=value` members of an alphabet, parted at the first `=`. A scope is steps apart by `/`, every step kept. A region is `name@resolution`, its resolution digits or `*`. Each function reads its text and writes it back canonical, and what it writes reads back the same." at=policy:wire-page by=owner epoch=1 form=alphabet measure=text role=writes scope=prose/en/wire/values sig="ed25519:era1:xNgg2UFFbII1fAmicrypRJHqOYW8i+39IZswRwJdNA1UmJyiqTcn+BU4U2GgDSkI2jEsiZJ+Jd+8IB11kac+BQ==" value=lock
bound-lock/1 about="Inside a value" at=policy:wire-page by=owner epoch=1 form=alphabet measure=text role=writes scope=prose/en/wire/values/heading sig="ed25519:era1:qOsggWAvyyH/7sX5tgoC8CRf/3tqJOUieFQMlv+wEgGLMp6Wg1tyay04w2qho/MJccfG3I5ywXDliwN3/TtnBw==" value=lock
bound-lock/1 about="the published place's first line: its lock begins here at epoch one, judged by a bound not yet on npm; a token publishes once, and every publish after it is the trusted publisher's" at=witness:a-topos-that-was-not-a-place by=owner epoch=1 form=alphabet measure=status role=writes scope=publish/bootstrap sig="ed25519:era1:7rcOJIygVblrbvnmv0YB8Jub7A/eRCCE7/tNCbiyy9g8WLdj+LpBXVfXEgHkuBraB6Xs6bEkzkQsFQikPtShAQ==" value=topos
bound-lock/1 about="the version this place carries is on the registry: it rests on published/topos/0.1.0, the FACT npm view lands, and stands owed until that is paid" at=witness:a-publish-that-failed-and-read-green by=owner condition=published/0.1.0 epoch=1 form=alphabet measure=status role=demands scope=published/0.1.0 sig="ed25519:era1:sT/dGo2Sd61meQTRYg4vu8MCKVaKvmomul/NXKCB0AGKMctf/T+xnYQJc388RQWdFLKqfCYMvapjTL6L+ayeAg==" value=present
bound-lock/1 about="the regions spoken in more this epoch than last" at=policy:region/approaching by=owner epoch=1 form=alphabet measure=text role=writes scope=region/approaching sig="ed25519:era1:nP9k9fyCP9cjeeXWkcgMwE/CdHSbNnjb0RS8cDXjpRqBp6xWzruzUzjL2vufPNfupgzujA5e9/A+cXyQ9pw0Cw==" value=lock
bound-lock/1 at=witness:a-lot-that-landed-at-every-place by=owner epoch=1 form=alphabet measure=coordinates role=reads scope=region/artifacts sig="ed25519:era1:W5pGBvmk0CqQGIqC/PGpH/IiximKrDcKFwhpKkF5NGzyuSvj3xD4jIsheTlHc0pBru/sD6pWcnQ0CLzHuAPAAQ==" value=src/**/*.js|src/**/*.ts
